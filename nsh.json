{
  "name": "Spotish",
  "id": "dev.huacnlee.spotish",
  "version": "0.1.6",
  "build": 1,
  "icon": {
    "macos": "icon-macos.png",
    "windows": "icon-rounded.png",
    "linux": "icon-rounded.png",
    "web": "icon-rounded.png",
    "ios": "icon.png",
    "android": "icon.png"
  },
  "appearance": "system",
  "theme": "theme.json",
  "window": {
    "titleBar": {
      "style": "hidden",
      "height": 52
    }
  },
  "rust": ".",
  "minRuntime": "0.7.0",
  "updater": {
    "github": "huacnlee/spotish"
  },
  "macos": {
    "infoPlist": {
      "NSAudioCaptureUsageDescription": "Spotish listens to the music it plays so its lights move with the beat. The sound never leaves this Mac."
    }
  },
  "dependencies": {
    "nsh-icon": "^0.2.1",
    "nsh-icon-tabler": "^0.2.1",
    "nsmetry": "^0.1.0"
  }
}
