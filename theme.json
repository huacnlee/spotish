      "primary": "#1aa34a",
      "primary-foreground": "#ffffff",
      "secondary": "#ebebeb",
      "secondary-foreground": "var(--foreground)",
      "muted": "#e6e6e6",
      "muted-foreground": "#6a6a6a",
      "accent": "#ececec",
      "accent-foreground": "var(--foreground)",
      "destructive": "#d43a4a",
      "border": "#e2e2e2",
