      "accent-foreground": "var(--foreground)",
      "destructive": "#f15e6c",
      "border": "#2a2a2a",
      "input": "#3e3e3e",
      "ring": "#1ed760",
      "sidebar": "#121212",
      "sidebar-foreground": "var(--foreground)",
      "sidebar-accent": "#1f1f1f",
      "sidebar-accent-foreground": "var(--foreground)",
      "sidebar-border": "#242424",
